<skill-header>
    <skill-name>
        {{#if url}}
            <a href="{{url}}" target="_blank" rel="noopener">{{name}}</a>
        {{else}}
            <span>{{name}}</span>
        {{/if}}
    </skill-name>

    {{#if hasCost}}
        <skill-cost>
            {{#if spCost}}
                <span>
                    {{#repeat spCost}}<source-icon></source-icon>{{/repeat}}
                </span>
            {{/if}}

            {{#if apCost}}
                <span>
                    {{#repeat apCost}}<ap-icon></ap-icon>{{/repeat}}
                </span>
            {{/if}}
        </skill-cost>
    {{/if}}

</skill-header>

<skill-effect>{{{effect}}}</skill-effect>

<skill-requirements>
    <req-badge data-tree="{{lowercase secondaryTree}}">
        {{~secondaryTree}} {{investment~}}
    </req-badge>
    <req-badge data-tree="{{lowercase primaryTree}}">
        {{~primaryTree}} {{investment~}}
    </req-badge>
</skill-requirements>

<skill-metadata>
    <skill-range>{{range}}</skill-range>
    <skill-cooldown>{{cooldown}}</skill-cooldown>
</skill-metadata>
